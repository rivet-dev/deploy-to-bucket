{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"lib": ["ES2022"],
		"types": ["node"],
		"strict": true,
		"verbatimModuleSyntax": true,
		"skipLibCheck": true,
		"noEmitOnError": true,
		"rootDir": ".",
		"outDir": "dist"
	},
	"include": ["core.ts", "deploy.ts", "uploads.ts", "types.ts"]
}
