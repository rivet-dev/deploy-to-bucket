{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "example-website-router",
	"main": "worker.ts",
	"account_id": "REPLACE_WITH_ACCOUNT_ID",
	"compatibility_date": "2026-11-09",
	"workers_dev": false,
	"preview_urls": false,
	"observability": { "enabled": true },
	"r2_buckets": [{ "binding": "BUCKET", "bucket_name": "example-website" }],
	// The action manages exact Custom Domains. Omit routes so future Worker
	// upgrades preserve dynamically attached production and preview hostnames.
}
