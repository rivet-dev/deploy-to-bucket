{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "example-website-router",
	"main": "worker.ts",
	"account_id": "REPLACE_WITH_ACCOUNT_ID",
	"compatibility_date": "2026-11-09",
	"workers_dev": false,
	"preview_urls": false,
	"observability": { "enabled": true },
	"r2_buckets": [{ "binding": "BUCKET", "bucket_name": "example-website" }],
	"routes": [
		{ "pattern": "website.gameinc.io", "custom_domain": true },
		{ "pattern": "*.preview.gameinc.io/*", "zone_name": "gameinc.io" },
	],
}
